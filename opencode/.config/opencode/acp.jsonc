{
    "$schema": "https://raw.githubusercontent.com/ranxianglei/opencode-acp/master/dcp.schema.json",
    "enabled": true,
    "autoUpdate": true,
    "debug": false,
    "pruneNotification": "minimal",
    "pruneNotificationType": "toast",
    "commands": {
        "enabled": true
    },
    "allowSubAgents": true,
    "compress": {
        "permission": "allow",
        "showCompression": true,
        "summaryBuffer": true,

        // Default: 500k for all models; GPT models from OAI providers
        // override to 350k via providers below.
        "maxContextLimit": 500000,
        "minContextLimit": 500000,

        "nudgeFrequency": 1,
        "minNudgeContextPercent": 100,
        "nudgeGrowthTokens": 500000,
        "toolOutputNudgeThreshold": 500000,
        "minNudgeGrowthFloor": 500000,
        "iterationNudgeThreshold": 1000000,
        "nudgeForce": "strong",
        "providers": {
            "openai": {
                "maxContextLimit": 350000,
                "emergencyThresholdPercent": 350000,
                "nudgeGrowthTokens": 350000,
                "toolOutputNudgeThreshold": 350000,
                "minNudgeGrowthFloor": 350000
            }
        },

        // Preserve the current plan/reasoning and latest user instruction.
        "preserveRecentMessages": 2,
        "preserveRecentTokens": 3000,
        "preserveLastUserMessage": true,
        "lastSegmentSoftBlock": false,
        "minCompressRange": 3000,
        "maxSummaryLengthHard": 12000,
        "emergencyThresholdPercent": 500000,
        "protectedTools": ["skill", "compress"]
    },
    "gc": {
        "promotionThreshold": 4,
        "maxOldGenSummaryLength": 4000,
        "majorGcThresholdPercent": 500000,
        "batchCleanup": {
            "lowThreshold": 500000,
            "highThreshold": 500000,
            "forceThreshold": 500000
        }
    },
    "qualityGate": {
        "enabled": false
    }
}
