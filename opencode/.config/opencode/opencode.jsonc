{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "webfetch": "allow",
        "websearch": "allow"
    },
    "provider": {
        "lmstudio": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LM Studio (local)",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1"
            },
            "models": {
                "google/gemma-4-12b": {
                    "name": "Gemma 4 12B (local)"
                }
            }
        }
    }
}
