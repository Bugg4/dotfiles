{
    "$schema": "https://opencode.ai/config.json",
    "share": "disabled",
    "compaction": {
        "auto": false,
        "prune": false,
        "reserved": 10000
    },
    "permission": {
        "edit": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "skill": {
            "*": "allow",
            "deep-research": "ask"
        },
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
            "*": "ask",
            "grep *": "allow",
            "rg *": "allow",
            "git status*": "allow",
            "git log*": "allow",
            "git diff*": "allow",
            "ls *": "allow",
            "which *": "allow",
            "node *": "allow",
            "npm test*": "allow",
            "git push*": "ask",
            "git commit*": "ask",
            "git add*": "ask",
            "rm *": "ask",
            "rmdir *": "ask",
            "mv *": "ask",
            "cp *": "ask",
            "chmod *": "ask",
            "sudo *": "ask"
        }
    },
    "provider": {
        "lmstudio": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LM Studio (local)",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1"
            }
            // Models are auto-discovered from the running LM Studio server
            // (/v1/models) by the opencode-lmstudio plugin — no need to list
            // them here. Just load a model in LM Studio and restart opencode.
        },
        "llama.cpp": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama.cpp",
            "options": {
                "baseURL": "http://127.0.0.1:8080/v1"
            },
            "models": {
                "qwen3.8-27b": {
                    "name": "Qwen3.8 27B Q4_K_M (local/256k)",
                    "family": "qwen",
                    "temperature": true,
                    "reasoning": true,
                    "tool_call": true,
                    "interleaved": "reasoning_content",
                    "modalities": {
                        "input": ["text"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    }
                },
                "qwen3.8-27b-vram": {
                    "name": "Qwen3.8 27B UD-Q3_K_XL (local/64k)",
                    "family": "qwen",
                    "temperature": true,
                    "reasoning": true,
                    "tool_call": true,
                    "interleaved": "reasoning_content",
                    "modalities": {
                        "input": ["text"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 65536,
                        "output": 16384
                    }
                },
                "qwen3.8-27b-coding": {
                    "name": "Qwen3.8 27B UD-Q3_K_XL + MTP (local/56k)",
                    "family": "qwen",
                    "temperature": true,
                    "reasoning": true,
                    "tool_call": true,
                    "interleaved": "reasoning_content",
                    "modalities": {
                        "input": ["text"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 57344,
                        "output": 8192
                    }
                }
            }
        }
    },
    "formatter": true,
    "watcher": {
        "ignore": [
            "node_modules/**",
            "dist/**",
            ".git/**",
            "build/**",
            ".next/**",
            ".cache/**",
            "coverage/**",
            ".venv/**",
            "__pycache__/**",
            "target/**"
        ]
    },
    "mcp": {
        "pdf_reader": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@sylphx/pdf-reader-mcp"
            ],
            "enabled": true
        },
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "@playwright/mcp@latest",
                "--extension",
                "--executable-path",
                "/opt/brave-bin/brave"
            ],
            "enabled": true
        }
    },
    "plugin": [
        "@tarquinen/opencode-dcp@latest",
        "opencode-lmstudio@latest",
        "./plugins/filter-lmstudio-embeddings.ts"
    ]
}
