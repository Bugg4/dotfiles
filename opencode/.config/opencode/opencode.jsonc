{
    "$schema": "https://opencode.ai/config.json",
    "share": "disabled",
    "compaction": {
        "auto": false,
        "prune": false,
        "reserved": 10000
    },
    "permission": {
        "edit": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "skill": {
            "*": "allow",
            "deep-research": "ask"
        },
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
            "*": "ask",
            "grep *": "allow",
            "rg *": "allow",
            "git status*": "allow",
            "git log*": "allow",
            "git diff*": "allow",
            "ls *": "allow",
            "which *": "allow",
            "node *": "allow",
            "npm test*": "allow",
            "git push*": "ask",
            "git commit*": "ask",
            "git add*": "ask",
            "rm *": "ask",
            "rmdir *": "ask",
            "mv *": "ask",
            "cp *": "ask",
            "chmod *": "ask",
            "sudo *": "ask"
        }
    },
    "provider": {
        "lmstudio": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LM Studio (local)",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1"
            }
            // Models are auto-discovered from the running LM Studio server
            // (/v1/models) by the opencode-lmstudio plugin — no need to list
            // them here. Just load a model in LM Studio and restart opencode.
        }
    },
    "formatter": true,

    "watcher": {
        "ignore": [
            "node_modules/**",
            "dist/**",
            ".git/**",
            "build/**",
            ".next/**",
            ".cache/**",
            "coverage/**",
            ".venv/**",
            "__pycache__/**",
            "target/**"
        ]
    },

    "mcp": {
        "pdf_reader": {
            "type": "local",
            "command": ["npx", "-y", "@sylphx/pdf-reader-mcp"],
            "enabled": true
        },
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "@playwright/mcp@latest",
                "--extension",
                "--executable-path",
                "/opt/brave-bin/brave"
            ],
            "enabled": true
        }
    },
    "plugin": [
        "@tarquinen/opencode-dcp@latest",
        "./plugins/override-system-prompt.ts",
        "opencode-lmstudio@latest",
        "./plugins/filter-lmstudio-embeddings.ts"
    ]
}
