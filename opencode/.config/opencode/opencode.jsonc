{
    "$schema": "https://opencode.ai/config.json",
    "share":"disabled",
    "permission": {
        "edit": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "skill": "allow",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
            "*": "ask",
            "grep *": "allow",
            "rg *": "allow",
            "git status*": "allow",
            "git log*": "allow",
            "git diff*": "allow",
            "ls *": "allow",
            "which *": "allow",
            "node *": "allow",
            "npm test*": "allow",
            "npm run *": "allow",
            "git push*": "ask",
            "git commit*": "ask",
            "git add*": "ask",
            "rm *": "deny",
            "rmdir *": "deny",
            "mv *": "ask",
            "cp *": "ask",
            "chmod *": "deny",
            "sudo *": "deny"
        }
    },
    "provider": {
        "lmstudio": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LM Studio (local)",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1"
            },
            "models": {
                "google/gemma-4-12b": {
                    "name": "Gemma 4 12B (local)"
                }
            }
        }
    },
    "formatter": true,

    "watcher": {
        "ignore": [
            "node_modules/**",
            "dist/**",
            ".git/**",
            "build/**",
            ".next/**",
            ".cache/**",
            "coverage/**",
            ".venv/**",
            "__pycache__/**",
            "target/**"
        ]
    },

    "mcp": {
        "postgres": {
            "type": "local",
            "command": ["npx", "-y", "@yawlabs/postgres-mcp@latest"],
            "environment": {
                "DATABASE_URL": "{env:DATABASE_URL}"
            },
            "enabled": true
        },
        "mongo": {
            "type": "local",
            "command": ["npx", "-y", "mongodb-mcp-server@latest", "--readOnly"],
            "environment": {
                "MDB_MCP_CONNECTION_STRING": "{env:MONGODB_URI}"
            },
            "enabled": true
        }
    },
    "plugin": [
      "@tarquinen/opencode-dcp@latest"
    ]
}
