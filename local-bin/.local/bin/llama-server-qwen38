#!/usr/bin/env bash
set -euo pipefail

# Qwen3.8-27B launcher tuned for this machine:
# RTX 5070 Ti 16GB, Ryzen 9 9900X3D, 96GB system RAM.
#
# Usage:
#   llama-server-qwen38                 # native 262K, F16 KV
#   PROFILE=fast llama-server-qwen38
#   PROFILE=q8 llama-server-qwen38
#   PROFILE=vram llama-server-qwen38    # 64K, fully GPU-resident
#   PROFILE=coding llama-server-qwen38  # 57,344, all-VRAM + MTP
#   VISION=1 llama-server-qwen38
#
# Optional overrides: PORT, HOST, MODEL, MMPROJ, FIT_TARGET, PROFILE, VISION,
# GPU_INDEX, MIN_FREE_VRAM_MIB.
# The coding and vram profiles perform a VRAM preflight. Override the
# empirical threshold when necessary, for example:
#   MIN_FREE_VRAM_MIB=14500 PROFILE=coding llama-server-qwen38
# Additional command-line arguments are passed to llama-server last.

MODEL="${MODEL:-}"
MMPROJ="${MMPROJ:-$HOME/.lmstudio/models/lmstudio-community/Qwen3.8-27B-GGUF/mmproj-Qwen3.8-27B-BF16.gguf}"
HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-8080}"
PROFILE="${PROFILE:-full}"
VISION="${VISION:-0}"
FIT_TARGET="${FIT_TARGET:-1280}"
GPU_INDEX="${GPU_INDEX:-0}"

mapfile -t runtime_dirs < <(printf '%s\n' "$HOME"/.lmstudio/extensions/backends/llama.cpp-linux-x86_64-nvidia-cuda12-avx2-* | sort -V)
RUNTIME_DIR="${runtime_dirs[-1]}"
LM_SERVER="$RUNTIME_DIR/llama-server"
SOURCE_SERVER="$HOME/code/llama.cpp/build-sm120-fa-all/bin/llama-server"
SERVER="$LM_SERVER"
VENDOR_DIR="$HOME/.lmstudio/extensions/backends/vendor/linux-llama-cuda12-vendor-v1"
USE_VENDOR=1
THREADS_BATCH=24
runtime_args=()

case "$PROFILE" in
full)
	DEFAULT_MODEL="$HOME/.lmstudio/models/lmstudio-community/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf"
	CTX=262144
	CACHE=f16
	BATCH=8192
	UBATCH=2048
	ALIAS=qwen3.8-27b
	gpu_args=(--gpu-layers auto --fit on --fit-target "$FIT_TARGET")
	spec_args=(--spec-type draft-mtp --spec-draft-n-max 3 --spec-draft-type-k q8_0 --spec-draft-type-v q8_0)
	;;
fast)
	DEFAULT_MODEL="$HOME/.lmstudio/models/lmstudio-community/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf"
	CTX=131072
	CACHE=f16
	BATCH=8192
	UBATCH=2048
	ALIAS=qwen3.8-27b
	gpu_args=(--gpu-layers auto --fit on --fit-target "$FIT_TARGET")
	spec_args=(--spec-type draft-mtp --spec-draft-n-max 3 --spec-draft-type-k q8_0 --spec-draft-type-v q8_0)
	;;
q8)
	DEFAULT_MODEL="$HOME/.lmstudio/models/lmstudio-community/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf"
	CTX=262144
	CACHE=q8_0
	BATCH=8192
	UBATCH=2048
	ALIAS=qwen3.8-27b
	gpu_args=(--gpu-layers auto --fit on --fit-target "$FIT_TARGET")
	spec_args=(--spec-type draft-mtp --spec-draft-n-max 3 --spec-draft-type-k q8_0 --spec-draft-type-v q8_0)
	;;
vram)
	DEFAULT_MODEL="$HOME/.lmstudio/models/unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q3_K_XL.gguf"
	CTX=65536
	CACHE=q4_0
	BATCH=1024
	UBATCH=256
	ALIAS=qwen3.8-27b-vram
	gpu_args=(--gpu-layers 999 --fit off)
	spec_args=()
	;;
coding)
	DEFAULT_MODEL="$HOME/.lmstudio/models/unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q3_K_XL.gguf"
	CTX=57344
	CACHE=q4_0
	BATCH=256
	UBATCH=128
	ALIAS=qwen3.8-27b-coding
	SERVER="$SOURCE_SERVER"
	USE_VENDOR=0
	THREADS_BATCH=12
	gpu_args=(--gpu-layers 999 --fit off)
	spec_args=(
		--spec-type draft-mtp
		--spec-draft-n-max 3
		--spec-draft-p-min 0.0
		--spec-draft-type-k q4_0
		--spec-draft-type-v q4_0
	)
	runtime_args=(--no-warmup --cache-prompt --cache-ram 8192 --ctx-checkpoints 32)
	;;
*)
	printf 'Unknown PROFILE=%s (use full, fast, q8, vram, or coding)\n' "$PROFILE" >&2
	exit 2
	;;
esac

if [[ ! -x "$SERVER" ]]; then
	printf 'llama-server not found at %s\n' "$SERVER" >&2
	exit 1
fi

MODEL="${MODEL:-$DEFAULT_MODEL}"

if [[ ! -f "$MODEL" ]]; then
	printf 'Model not found at %s\n' "$MODEL" >&2
	exit 1
fi

if [[ ("$PROFILE" == vram || "$PROFILE" == coding) && "$VISION" == 1 ]]; then
	printf 'PROFILE=%s is text-only: the vision projector does not fit with the all-VRAM profile\n' "$PROFILE" >&2
	exit 2
fi

# All-VRAM profiles need a large contiguous allocation for the model, KV
# cache, MTP context, and compute graphs. Auto-fit profiles are deliberately
# not blocked here because llama.cpp can move more layers to system RAM.
case "$PROFILE" in
coding) DEFAULT_MIN_FREE_VRAM_MIB=15000 ;;
vram) DEFAULT_MIN_FREE_VRAM_MIB=14500 ;;
*) DEFAULT_MIN_FREE_VRAM_MIB=0 ;;
esac
MIN_FREE_VRAM_MIB="${MIN_FREE_VRAM_MIB:-$DEFAULT_MIN_FREE_VRAM_MIB}"
if [[ ! "$MIN_FREE_VRAM_MIB" =~ ^[0-9]+$ ]]; then
	printf 'MIN_FREE_VRAM_MIB must be a non-negative integer, got: %s\n' "$MIN_FREE_VRAM_MIB" >&2
	exit 2
fi

print_vram_processes() {
	printf 'GPU processes currently using VRAM:\n'
	printf '  %-8s %-10s %-42s %s\n' 'PID' 'VRAM' 'NVIDIA name' 'Command'
	printf '  %-8s %-10s %-42s %s\n' '--------' '----------' '------------------------------------------' '-------'

	local rows pid name memory command
	rows="$(nvidia-smi -i "$GPU_INDEX" 2>/dev/null | awk -F'|' '
		/Processes:/ { in_processes = 1; next }
		in_processes && $0 ~ /\|[[:space:]]*[0-9]+[[:space:]]+N\/A/ {
			row = $2
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", row)
			n = split(row, field, /[[:space:]]+/)
			if (n >= 7 && (field[5] == "G" || field[5] == "C" || field[5] == "M")) {
				printf "%s\t%s\t%s\n", field[4], field[6], field[7]
			}
		}
	')"

	if [[ -z "$rows" ]]; then
		printf '  (nvidia-smi reported no individual process rows)\n'
		return
	fi

	while IFS=$'\t' read -r pid name memory; do
		[[ -z "$pid" ]] && continue
		command="$(ps -p "$pid" -o args= 2>/dev/null || true)"
		printf '  %-8s %-10s %-42s %s\n' "$pid" "$memory" "$name" "${command:-<process exited>}"
	done <<< "$rows"
}

if (( MIN_FREE_VRAM_MIB > 0 )); then
	if ! command -v nvidia-smi >/dev/null 2>&1; then
		printf 'Warning: nvidia-smi is unavailable; skipping the VRAM preflight.\n' >&2
	else
		free_vram_mib="$(nvidia-smi -i "$GPU_INDEX" --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | tr -d '[:space:]')"
		if [[ ! "$free_vram_mib" =~ ^[0-9]+$ ]]; then
			printf 'Warning: could not read free VRAM on GPU %s; skipping the VRAM preflight.\n' "$GPU_INDEX" >&2
		elif (( free_vram_mib < MIN_FREE_VRAM_MIB )); then
			printf 'Not enough free VRAM for profile=%s.\n' "$PROFILE" >&2
			printf 'Required free VRAM: %s MiB; currently free: %s MiB.\n' \
				"$MIN_FREE_VRAM_MIB" "$free_vram_mib" >&2
			printf 'Close or kill one or more listed processes, then retry.\n' >&2
			print_vram_processes >&2
			printf 'Example: kill <PID>  (use kill -KILL <PID> only if necessary).\n' >&2
			exit 78
		fi
	fi
fi

vision_args=(--no-mmproj)
if [[ "$VISION" == 1 ]]; then
	if [[ ! -f "$MMPROJ" ]]; then
		printf 'Vision projector not found at %s\n' "$MMPROJ" >&2
		exit 1
	fi
	vision_args=(--mmproj "$MMPROJ")
fi

if (( USE_VENDOR )); then
	export LD_LIBRARY_PATH="$VENDOR_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

printf 'Starting Qwen3.8-27B: profile=%s ctx=%s cache=%s vision=%s\n' \
	"$PROFILE" "$CTX" "$CACHE" "$VISION"

exec "$SERVER" \
	--model "$MODEL" \
	"${vision_args[@]}" \
	--ctx-size "$CTX" \
	"${gpu_args[@]}" \
	--flash-attn on --jinja \
	--parallel 1 --threads 12 --threads-batch "$THREADS_BATCH" \
	--batch-size "$BATCH" --ubatch-size "$UBATCH" \
	"${spec_args[@]}" \
	"${runtime_args[@]}" \
	--cache-type-k "$CACHE" --cache-type-v "$CACHE" \
	--temperature 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 \
	--presence-penalty 0.0 \
	--chat-template-kwargs '{"reasoning_effort":"medium"}' \
	--reasoning-preserve \
	--alias "$ALIAS" \
	--host "$HOST" --port "$PORT" \
	"$@"
