#!/usr/bin/env bash
# Browse a KeePass database with fzf and copy attributes to the clipboard.
#
# Usage: keepass-cli-wrapper [-k keyfile] [-t seconds] [-1] <database.kdbx>
#   -k FILE   key file (if the database uses one)
#   -t SECS   clear the clipboard after SECS seconds (default 30, 0 = never)
#   -1        exit after the first copy instead of returning to the entry list
#
# The password is asked once; Esc in the entry list quits.

set -u

CLIPBOARD_TIMEOUT=30
ONCE=0
KEYFILE_ARGS=()

usage() {
    sed -n '4,8s/^# \{0,1\}//p' "$0" >&2
    exit "${1:-1}"
}

while getopts ":k:t:1h" opt; do
    case "$opt" in
        k) KEYFILE_ARGS=(-k "$OPTARG") ;;
        t) CLIPBOARD_TIMEOUT="$OPTARG" ;;
        1) ONCE=1 ;;
        h) usage 0 ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
[ $# -eq 1 ] || usage
DB_PATH="$1"
[ -f "$DB_PATH" ] || { echo >&2 "Database not found: $DB_PATH"; exit 1; }

need() {
    command -v "$1" >/dev/null 2>&1 || { echo >&2 "$1 is required but not installed. Aborting."; exit 1; }
}
need keepassxc-cli
need fzf

# Clipboard backend: Wayland first, then X11.
if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
    clip_copy()  { wl-copy; }
    clip_paste() { wl-paste --no-newline 2>/dev/null; }
    clip_clear() { wl-copy --clear; }
elif command -v xclip >/dev/null 2>&1; then
    clip_copy()  { xclip -selection clipboard -in; }
    clip_paste() { xclip -selection clipboard -out 2>/dev/null; }
    clip_clear() { printf '' | xclip -selection clipboard -in; }
elif command -v xsel >/dev/null 2>&1; then
    clip_copy()  { xsel --clipboard --input; }
    clip_paste() { xsel --clipboard --output 2>/dev/null; }
    clip_clear() { xsel --clipboard --clear; }
else
    echo >&2 "No clipboard tool found (need wl-copy, xclip or xsel). Aborting."
    exit 1
fi

# Run keepassxc-cli with the password fed on stdin (printf is a builtin: not visible in ps).
kp() {
    local cmd="$1"; shift
    printf '%s\n' "$DB_PASS" | keepassxc-cli "$cmd" -q "${KEYFILE_ARGS[@]}" "$DB_PATH" "$@"
}

trap 'unset DB_PASS' EXIT
read -rs -p "Password for $(basename "$DB_PATH"): " DB_PASS
echo
[ -n "$DB_PASS" ] || { echo >&2 "Password cannot be empty."; exit 1; }

echo "Opening database..."
if ! ENTRIES=$(kp ls -R -f 2>&1); then
    echo >&2 "Could not open database: wrong password/key file, or the file is unreadable."
    exit 1
fi
ENTRIES=$(grep -v -e '/$' -e '^$' <<<"$ENTRIES")
[ -n "$ENTRIES" ] || { echo >&2 "Database has no entries."; exit 1; }

# Copy a secret, then clear it after the timeout, but only if it's still on the clipboard
# (so we don't wipe something you copied in the meantime).
copy_secret() {
    local secret="$1"
    printf '%s' "$secret" | clip_copy
    if [ "$CLIPBOARD_TIMEOUT" -gt 0 ] 2>/dev/null; then
        local hash
        hash=$(printf '%s' "$secret" | sha256sum)
        (
            sleep "$CLIPBOARD_TIMEOUT"
            [ "$(clip_paste | sha256sum)" = "$hash" ] && clip_clear
        ) >/dev/null 2>&1 &
        disown
    fi
}

FZF_OPTS=(--height=40% --layout=reverse --border)

# In -1 mode an error ends the run; otherwise go back to the entry list.
next_or_exit() { [ "$ONCE" -eq 1 ] && exit 1; return 0; }

while :; do
    ENTRY=$(fzf "${FZF_OPTS[@]}" --prompt="Entry > " <<<"$ENTRIES") || break

    if ! RAW=$(kp show --all "$ENTRY" 2>&1); then
        echo >&2 "Could not read entry: $RAW"
        next_or_exit; continue
    fi

    # Output is "Key: value" lines, but multi-line Notes continue on bare lines until "Uuid:".
    # Skip those continuations (marking Notes with "…"), and hide Uuid.
    MENU=$(in_notes=0
        while IFS= read -r line; do
            case "$line" in
                Notes:*) in_notes=1; notes="$line"; continue ;;
                Uuid:*)
                    [ "$in_notes" -eq 1 ] && printf '%s\n' "$notes"
                    in_notes=0; continue ;;
            esac
            if [ "$in_notes" -eq 1 ]; then
                notes="${notes%…} …"
                continue
            fi
            [[ "$line" == *:* ]] && printf '%s\n' "$line"
        done <<<"$RAW")
    MENU+=$'\n'"TOTP: (generate code)"

    LINE=$(fzf "${FZF_OPTS[@]}" --prompt="$ENTRY > " <<<"$MENU") || continue
    KEY=${LINE%%:*}

    if [ "$KEY" = "TOTP" ]; then
        if ! SECRET=$(kp show -t "$ENTRY" 2>&1); then
            echo >&2 "$ENTRY has no TOTP configured."
            next_or_exit; continue
        fi
    else
        if ! SECRET=$(kp show -s -a "$KEY" "$ENTRY" 2>&1); then
            echo >&2 "Could not read '$KEY': $SECRET"
            next_or_exit; continue
        fi
    fi

    if [ -z "$SECRET" ]; then
        echo "'$KEY' is empty, nothing copied."
        next_or_exit; continue
    fi

    copy_secret "$SECRET"
    unset SECRET
    if [ "$CLIPBOARD_TIMEOUT" -gt 0 ] 2>/dev/null; then
        echo "Copied '$KEY' from '$ENTRY' (clears in ${CLIPBOARD_TIMEOUT}s)."
    else
        echo "Copied '$KEY' from '$ENTRY'."
    fi

    [ "$ONCE" -eq 1 ] && break
done
